// Builder database - content, drafts, templates, publish pointers.
// Read-heavy, rebuildable from a bad publish. No PHI/PII lives here.

generator client {
  provider      = "prisma-client-js"
  // Separate output so this client doesn't overwrite the HMS one in
  // node_modules/@prisma/client (both schemas live in the same monorepo).
  output        = "../src/generated/client"
  // native = local Windows/Mac; rhel = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("BUILDER_DATABASE_URL")
}

model Hospital {
  id          String   @id @default(uuid())
  slug        String   @unique // used for hospital.nabhicares.com/{slug}
  name        String
  customDomain String? @unique
  seoTitle       String?
  seoDescription String?
  createdAt   DateTime @default(now())

  pages         Page[]
  publishes     Publish[]
  designSystem  DesignSystem?
  memberships   HospitalMembership[]
}

// Studio operators. Password auth for now (scrypt). Super admins see all hospitals.
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  isSuperAdmin   Boolean  @default(false)
  /// Bump to invalidate all HMAC session cookies for this user (stateless kill switch).
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())

  memberships HospitalMembership[]
  auditLogs   AuditLog[]
}

enum MembershipRole {
  EDITOR    // edit pages/sections/design
  PUBLISHER // EDITOR + publish/rollback
  ADMIN     // PUBLISHER + manage hospital settings / members (later)
}

model HospitalMembership {
  id         String         @id @default(uuid())
  userId     String
  hospitalId String
  role       MembershipRole @default(EDITOR)
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  hospitalId String?
  action     String   // e.g. publish, rollback, hospital.delete
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([actorId, createdAt])
}

// Per-hospital (or brand-preset) visual tokens. Injected as CSS custom
// properties at build time — never stored inside Section.content.
model DesignSystem {
  id          String   @id @default(uuid())
  hospitalId  String   @unique
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  tokens      Json     // { colors, typography, spacing, radii }
  updatedAt   DateTime @updatedAt
}

// A reusable, versioned layout/section that developers build in Studio.
// Hospitals never edit this directly - they only reference a version.
model Template {
  id          String   @id @default(uuid())
  key         String   // e.g. "hero", "doctors-grid", "faq-accordion"
  version     Int
  schema      Json     // JSON schema describing editable fields for this version
  componentRef String  // resolves to the actual component in the section registry
  createdAt   DateTime @default(now())

  @@unique([key, version])
  sections    Section[]
}

model Page {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  slug        String   // e.g. "home", "doctors", "contact"
  sortOrder   Int      @default(0)
  isDraft     Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    Section[]

  @@unique([hospitalId, slug])
}

// A section instance on a page: which template version + which content + enabled/disabled
model Section {
  id          String   @id @default(uuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id])
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])
  order       Int
  enabled     Boolean  @default(true)
  content     Json     // fills the template's schema - never colors/layout, content only
  /// Shape version for Section.content (see CONTENT_SCHEMA_VERSION in section-registry)
  contentSchemaVersion Int @default(0)
  updatedAt   DateTime @updatedAt
}

// One row per publish event. Immutable. This is what makes rollback free.
model Publish {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  status      PublishStatus @default(PENDING)
  snapshotPath String?  // s3 path: nabhicares-sites/{hospital_id}/versions/{publish_id}/
  triggeredBy String    // user id who clicked publish
  approvedBy  String?   // user id attesting content accuracy (defaults to triggeredBy)
  reviewNote  String?   // optional "I verified doctor credentials" note
  createdAt   DateTime @default(now())
  completedAt DateTime?
  isLive      Boolean  @default(false) // true for whichever publish is currently pointed at by "current/"
}

enum PublishStatus {
  PENDING
  BUILDING
  UPLOADING
  LIVE
  FAILED
  ROLLED_BACK
}
