# Builder database (content, drafts, templates)
BUILDER_DATABASE_URL="postgresql://builder:builder_dev_pw@localhost:5433/nabhicares_builder"

# HMS database (patients, appointments, billing) - RLS enforced.
# Use hms_app (NOT the docker superuser `hms`) so RLS policies apply.
HMS_DATABASE_URL="postgresql://hms_app:hms_app_dev_pw@localhost:5434/nabhicares_hms"

# Job queue (local compose sets requirepass — see REDIS_PASSWORD)
REDIS_PASSWORD="nabhicares_redis_dev"
REDIS_URL="redis://:nabhicares_redis_dev@localhost:6379"

# Snapshot store (MinIO locally, Cloudflare R2 in production)
SNAPSHOT_STORE_ENDPOINT="http://localhost:9000"
SNAPSHOT_STORE_KEY="nabhicares"
SNAPSHOT_STORE_SECRET="nabhicares_dev_pw"
# SNAPSHOT_STORE_PUBLIC_URL="https://….r2.cloudflarestorage.com"

# HMS backend
PORT=4000

# Public CDN / live site base (MUST be https:// in production)
CDN_PUBLIC_URL="http://localhost:8080"
NEXT_PUBLIC_CDN_PUBLIC_URL="http://localhost:8080"
# Studio origin for live-site appointment forms (public POST /api/public/...)
# Local: http://localhost:3000 — Prod: https://nabhi-studio.vercel.app (or custom domain)
NEXT_PUBLIC_STUDIO_API_URL="http://localhost:3000"
# Pilot root for hospital subdomains (e.g. {slug}.nabhilabs.info). Prod: nabhicares.com
# CDN_ROOT_DOMAIN="nabhilabs.info"
# NEXT_PUBLIC_CDN_ROOT_DOMAIN="nabhilabs.info"
# NEXT_PUBLIC_CDN_DNS_A="76.76.21.21"

# Studio session signing (required in production, ≥32 random bytes)
SESSION_SECRET="change-me-in-production-use-long-random"

# Optional: require approvedBy ≠ publisher when hospital has ≥2 PUBLISHER/ADMIN
# REQUIRE_DISTINCT_APPROVER=true

# --- Production / pilot DNS (Cloudflare Zone.DNS Edit token for fix-nabhilabs-cloudflare-dns.ps1) ---
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# BACKUP_S3_BUCKET=nabhicares-backups

# See docs/ops/CUSTOM_DOMAINS.md — nabhilabs.info pilot (BigRock NS → Cloudflare records → Vercel).
# If public DNS resolves to 127.0.0.1, Vercel Domains stay Invalid; run scripts/ops/fix-nabhilabs-cloudflare-dns.ps1

# Redis compose default password is DEV ONLY — never reuse nabhicares_redis_dev in prod.
# Object-store backup policy: docs/ops/OBJECT_STORE_RETENTION.md
# Pilot accounts / review gate: docs/ops/PILOT_ACCOUNTS.md
